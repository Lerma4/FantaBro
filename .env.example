# FantaBro — variabili d'ambiente.
#
# Copia questo file in `.env` e riempi i valori. Qui NON ci sono valori reali:
# `.env` è già ignorato da Git e non va mai committato.
#
# ATTENZIONE — i file di autenticazione dei provider AI (`auth.json`, le
# credenziali di Claude Code, la config di OpenCode) NON sono variabili
# d'ambiente e NON vanno mai messi nel repository: vivono solo su volumi
# persistenti (spec §39). Nemmeno in un layer Docker, nemmeno temporaneamente.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Usata da Drizzle Kit (`pnpm db:generate`, `pnpm db:migrate`) e dagli script.
DATABASE_URL=postgres://utente:password@localhost:5432/fantabro

# Stessa stringa, letta dall'applicazione: Nuxt popola `runtimeConfig.databaseUrl`
# dalla variabile con prefisso `NUXT_`. Per `pnpm dev` il database Docker è
# pubblicato su localhost:5433 (5432 può essere occupata dal devcontainer).
NUXT_DATABASE_URL=postgres://utente:password@localhost:5433/fantabro

# ---------------------------------------------------------------------------
# Autenticazione FantaBro (Better Auth)
# ---------------------------------------------------------------------------

# Segreto di firma delle sessioni. Genera un valore casuale lungo, per esempio:
#   openssl rand -base64 48
# Cambiarlo invalida tutte le sessioni attive.
NUXT_BETTER_AUTH_SECRET=

# URL pubblica da cui l'app è raggiunta, senza slash finale.
NUXT_BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Statistiche live Serie A (API-Football)
# ---------------------------------------------------------------------------
# Chiave privata API-Football: viene inviata solo dal server al provider e non
# viene mai esposta al browser. Senza chiave, le statistiche live restano
# semplicemente non disponibili; il listone e l'import Excel funzionano ugualmente.
NUXT_API_FOOTBALL_KEY=

# ---------------------------------------------------------------------------
# Primo utente ADMIN (`pnpm db:seed`)
# ---------------------------------------------------------------------------
# Non c'è registrazione pubblica: il primo account si crea con il seed.
# Cambia la password dopo il primo accesso.

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# ---------------------------------------------------------------------------
# Provider AI
# ---------------------------------------------------------------------------
# I provider usano le sessioni CLI GIÀ autenticate sul server. Non serve nessuna
# API key: non esiste alcun fallback su ANTHROPIC_API_KEY / OPENAI_API_KEY, e
# quelle variabili non vengono nemmeno passate ai processi AI (spec §34).
# Se la sessione manca, lo stato del provider è NOT_AUTHENTICATED.

# Provider preselezionato: claude-code | opencode | codex
NUXT_AI_DEFAULT_PROVIDER=claude-code

# Timeout per singola invocazione AI, in millisecondi. Copre anche l'attesa in coda.
NUXT_AI_TIMEOUT_MS=120000

# Richieste che possono attendere in coda per provider; oltre questo limite la
# risposta è PROVIDER_BUSY. La concorrenza per provider è fissa a 1: i file di
# sessione delle CLI non sono concurrency-safe.
NUXT_AI_MAX_PENDING=8

# Eseguibili delle CLI. Lasciali così se sono nel PATH del processo dell'app:
# il percorso concreto viene risolto automaticamente, anche su Windows dove le
# CLI installate via npm sono shim `.cmd` (vedi README.md).
NUXT_AI_CLAUDE_BIN=claude
NUXT_AI_OPENCODE_BIN=opencode
NUXT_AI_CODEX_BIN=codex

# URL del codex-worker interno. Se valorizzata, CodexProvider parla HTTP con il
# worker invece di eseguire `codex` in locale: è la modalità di produzione.
# Vuota = modalità locale (sviluppo).
#   Docker Compose / Kubernetes: http://codex-worker:8787
NUXT_AI_CODEX_WORKER_URL=

# ---------------------------------------------------------------------------
# Codex worker (solo per il processo del worker)
# ---------------------------------------------------------------------------

# Directory dell'autenticazione Codex persistente. DEVE stare su un volume, o
# il login non sopravvive al riavvio del container (spec §37).
# In sviluppo locale puoi lasciarla vuota per usare il default della CLI (~/.codex).
CODEX_HOME=/var/lib/codex

# Eseguibile della CLI Codex usato dal worker.
CODEX_BIN=codex

# Bind del worker. Il default 0.0.0.0 serve al Service ClusterIP; il worker non
# va MAI esposto da un Ingress.
CODEX_WORKER_HOST=0.0.0.0
CODEX_WORKER_PORT=8787

# Timeout e coda interna del worker (concorrenza fissa a 1).
CODEX_WORKER_TIMEOUT_MS=120000
CODEX_WORKER_MAX_PENDING=8

# ---------------------------------------------------------------------------
# Solo Docker Compose
# ---------------------------------------------------------------------------
# Credenziali del Postgres avviato dal compose e porta pubblicata dall'app.

POSTGRES_USER=fantabro
POSTGRES_PASSWORD=
POSTGRES_DB=fantabro
APP_PORT=3000

# Il compose legge anche BETTER_AUTH_SECRET e BETTER_AUTH_URL senza prefisso e
# li inoltra all'app come NUXT_*.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
